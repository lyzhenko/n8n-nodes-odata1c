# Environment used by the helper scripts (deploy/, scripts/live-check.mjs).
# Copy to .env and fill in; .env is ignored by git.

# n8n instance (REST API, used for checks)
N8N_PATH=http://192.168.0.11
N8N_USER=admin@example.com
N8N_PASS=change-me

# SSH access to the n8n host (deploy/deploy.py)
SSH_PATH=http://192.168.0.11
SSH_USER=eladm
SSH_PASS=change-me

# 1C infobase with the published OData interface (scripts/live-check.mjs)
ODATA_PATH=http://1c.example.com/erp/odata/standard.odata
ODATA_USER=odata_user
ODATA_PASS=change-me
